# ==============================================================================
# SkillHub Environment Configuration Template (.env.example)
# Author: Jose Diaz <josedelcarmen_diaz@outlook.com>
# Clan: Esthersita | Document ID: 1045755521
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#    cp .env.example .env
# 2. Modify values according to your local or production deployment environment.
# 3. Launch the containerized stack with Docker Compose:
#    docker compose up -d --build
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Name of the PostgreSQL database created at startup.
POSTGRES_DB=skillhub_db

# PostgreSQL superuser username.
POSTGRES_USER=postgres

# PostgreSQL superuser password (choose a strong password in production).
POSTGRES_PASSWORD=postgres

# Host port mapped to PostgreSQL inside the container (default: 5432).
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. ASP.NET Core Web API Configuration
# ------------------------------------------------------------------------------
# Host port where SkillHub API is published (default: 5142).
API_PORT=5142

# Environment mode: Development, Staging, or Production.
ASPNETCORE_ENVIRONMENT=Production

# Enable or disable automatic HTTPS redirection when behind a reverse proxy.
EnableHttpsRedirection=false

# ------------------------------------------------------------------------------
# 3. JWT (JSON Web Token) Security Settings
# ------------------------------------------------------------------------------
# Cryptographic symmetric signing key (MUST be at least 32 characters / 256 bits).
JWT_KEY=SkillHub_JwtSigningKey_2026_CleanArch_Min32Bytes!

# JWT Issuer claim ('iss') identifying the issuing authority.
JWT_ISSUER=SkillHubAPI

# JWT Audience claim ('aud') identifying the authorized recipient client.
JWT_AUDIENCE=SkillHubClient

# Access token validity duration in minutes.
JWT_EXPIRY_MINUTES=120

# ------------------------------------------------------------------------------
# 4. SMTP Transactional Email Settings (MailKit & Mailpit)
# ------------------------------------------------------------------------------
# Hostname of the SMTP server.
# In Docker Compose, 'mailpit' routes directly to the Mailpit container.
# In local development outside Docker, set to 'localhost'.
SMTP_HOST=mailpit

# Inbound SMTP port (1025 for Mailpit / Papercut, 587 for standard TLS SMTP).
SMTP_PORT=1025

# Enable or disable SSL/TLS encryption (false for local Mailpit testing).
SMTP_ENABLE_SSL=false

# Optional SMTP authentication credentials (leave empty for Mailpit).
SMTP_USER=
SMTP_PASSWORD=

# Sender email address appearing in the 'From' header of outgoing messages.
SMTP_FROM_EMAIL=no-reply@skillhub.internal

# Human-readable display name of the email sender.
SMTP_FROM_NAME=SkillHub Platform

# Port for accessing Mailpit's interactive Web UI mailbox in your browser.
MAILPIT_UI_PORT=8025
